<view wx:if="{{error}}" class="empty">
  <view class="big">😶</view>
  <view>{{error}}</view>
</view>

<block wx:elif="{{dish}}">
  <view class="head">
    <view class="title">{{dish.name}}</view>
    <view class="muted">分类：{{dish.category || '未分类'}}</view>
  </view>

  <view class="wrap">
    <view class="tag food">食材</view>
    <view class="card">
      <view wx:if="{{!dish.ingredients.length}}" class="muted small">没有填写食材</view>
      <view class="grid">
        <view class="cell {{item.have ? 'have' : ''}}" wx:for="{{dish.ingredients}}" wx:key="name">
          <view class="cell-emoji">{{item.emoji}}</view>
          <view class="cell-name">{{item.name}}</view>
          <view wx:if="{{item.have}}" class="dot">✓</view>
        </view>
      </view>
      <view wx:if="{{dish.ingredients.length}}" class="fridge-hint small">
        🧊 冰箱里有 {{haveCount}} / {{dish.ingredients.length}} 样
      </view>
    </view>

    <view class="tag prep">备菜</view>
    <view class="card steps prep-card">
      <view wx:if="{{!dish.prep.length}}" class="muted small">没有备菜步骤</view>
      <view class="step" wx:for="{{dish.prep}}" wx:key="index">
        <view class="num prep-num">{{index + 1}}</view>
        <text class="step-text" user-select>{{item}}</text>
      </view>
    </view>

    <view class="tag cook">炒菜</view>
    <view class="card steps cook-card">
      <view wx:if="{{!dish.cook.length}}" class="muted small">没有炒菜步骤</view>
      <view class="step" wx:for="{{dish.cook}}" wx:key="index">
        <view class="num cook-num">{{index + 1}}</view>
        <text class="step-text" user-select>{{item}}</text>
      </view>
    </view>
  </view>

  <view class="bottom-bar">
    <button class="btn soft" bindtap="copyRecipe">复制做法</button>
    <button class="btn primary" bindtap="openCook">炒好啦 🍳</button>
    <button class="btn ghost" bindtap="edit">修改</button>
  </view>

  <view class="mask" wx:if="{{cook.show}}" bindtap="closeCook">
    <view class="sheet" catchtap="noop">
      <view class="sheet-title">🍳 炒好啦！这次用了多少？</view>
      <view class="muted small sheet-sub">确认后从冰箱里扣掉。用量不对可以加减，也可以直接输入小数（¼ 个就填 0.25）</view>
      <scroll-view scroll-y class="sheet-body">
        <view class="cook-row" wx:for="{{cook.rows}}" wx:key="fridgeId">
          <view class="cook-emoji">{{item.emoji}}</view>
          <view class="cook-info">
            <view class="cook-name">{{item.name}}</view>
            <view class="muted small">冰箱里：{{item.haveText}}</view>
            <view wx:if="{{item.over}}" class="over small">≥ 库存，会记为用完</view>
          </view>
          <view wx:if="{{item.hasQty}}" class="stepper">
            <view class="st-btn" data-index="{{index}}" data-delta="-1" bindtap="stepCook">−</view>
            <input class="st-in" type="digit" value="{{item.qty}}" data-index="{{index}}" bindinput="onCookQty" />
            <view class="st-btn" data-index="{{index}}" data-delta="1" bindtap="stepCook">＋</view>
            <view class="st-unit">{{item.unit}}</view>
          </view>
          <label wx:else class="useup">
            <text class="small muted">用完了</text>
            <switch color="#D98A3D" checked="{{item.useUp}}" data-index="{{index}}" bindchange="toggleUseUp" />
          </label>
        </view>
        <view wx:if="{{cook.missing}}" class="muted small missing">冰箱里没有：{{cook.missing}}（不扣）</view>
      </scroll-view>
      <view class="sheet-btns">
        <button class="btn ghost" bindtap="closeCook">取消</button>
        <button class="btn primary" bindtap="confirmCook" disabled="{{cook.saving}}">{{cook.saving ? '更新中…' : '确认扣除'}}</button>
      </view>
    </view>
  </view>
</block>

<view wx:else class="empty">加载中…</view>
