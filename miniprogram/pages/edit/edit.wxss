.row { display: flex; gap: 16rpx; align-items: center; }
.flex { flex: 1; }
.add-btn { height: 80rpx; line-height: 80rpx; font-size: 28rpx; width: 140rpx !important; }
.ing-list { display: flex; flex-wrap: wrap; gap: 16rpx; margin-bottom: 16rpx; }
.ing { display: flex; align-items: center; background: var(--cell); border-radius: 40rpx; padding: 6rpx 10rpx 6rpx 8rpx; }
.ing-emoji { font-size: 40rpx; width: 56rpx; height: 56rpx; line-height: 56rpx; text-align: center; background: #fff; border-radius: 28rpx; }
.ing-name { font-size: 28rpx; margin: 0 8rpx 0 12rpx; }
.ing-x { color: var(--muted); font-size: 34rpx; padding: 0 10rpx; }

.step-edit { display: flex; align-items: flex-start; padding: 18rpx 0; border-bottom: 2rpx dashed var(--line); }
.num { flex-shrink: 0; width: 48rpx; height: 48rpx; border-radius: 10rpx; color: #fff; font-size: 26rpx; text-align: center; line-height: 48rpx; margin-right: 16rpx; margin-top: 4rpx; }
.prep-num { background: var(--prep); }
.cook-num { background: var(--cook); }
.step-input { flex: 1; width: 100%; min-width: 0; min-height: 56rpx; font-size: 30rpx; line-height: 1.6; padding: 4rpx 0; }
.step-ops { display: flex; margin-left: 8rpx; }
.op { color: var(--muted); font-size: 32rpx; width: 52rpx; text-align: center; line-height: 56rpx; }
.add-step { text-align: center; padding: 24rpx 0 8rpx; font-size: 28rpx; font-weight: 600; }
.prep-color { color: var(--prep); }
.cook-color { color: var(--cook); }

.mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,.4); z-index: 100; display: flex; align-items: flex-end; }
.picker { width: 100%; background: #fff; border-radius: 32rpx 32rpx 0 0; padding: 32rpx 24rpx calc(32rpx + env(safe-area-inset-bottom)); }
.picker-title { text-align: center; font-weight: 600; margin-bottom: 20rpx; }
.emoji-grid { display: flex; flex-wrap: wrap; }
.emoji { width: 12.5%; text-align: center; font-size: 48rpx; padding: 12rpx 0; }
