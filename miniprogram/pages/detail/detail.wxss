.head { background: #fff; padding: 24rpx 40rpx 36rpx; border-radius: 0 0 32rpx 32rpx; }
.title { font-size: 48rpx; font-weight: 800; margin-bottom: 8rpx; }
.wrap { padding-top: 32rpx; }
.grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 16rpx; }
.cell { position: relative; box-sizing: border-box; min-width: 0; border-radius: 16rpx; background: #FBF7F0; overflow: hidden; text-align: center; }
.cell-emoji { background: var(--cell); font-size: 64rpx; height: 116rpx; line-height: 116rpx; }
.cell-name { font-size: 24rpx; color: #6B6255; padding: 10rpx 4rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.dot { position: absolute; top: 6rpx; right: 6rpx; width: 32rpx; height: 32rpx; border-radius: 16rpx; background: var(--ok); color: #fff; font-size: 20rpx; line-height: 32rpx; }
.fridge-hint { margin-top: 18rpx; color: var(--muted); }
.steps { padding: 0 24rpx; }
.prep-card { border-color: var(--prep-line); }
.cook-card { border-color: var(--cook-line); }
.step { display: flex; align-items: flex-start; padding: 26rpx 0; border-bottom: 2rpx dashed var(--line); }
.step:last-child { border-bottom: none; }
.num { flex-shrink: 0; width: 48rpx; height: 48rpx; border-radius: 10rpx; color: #fff; font-size: 26rpx; text-align: center; line-height: 48rpx; margin-right: 20rpx; margin-top: 2rpx; }
.prep-num { background: var(--prep); }
.cook-num { background: var(--cook); }
.step-text { flex: 1; font-size: 31rpx; line-height: 1.6; }
.steps .muted { padding: 24rpx 0; }

.bottom-bar .btn.ghost { flex: 0 0 150rpx; }
.mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,.4); z-index: 100; display: flex; align-items: flex-end; }
.sheet { width: 100%; background: #fff; border-radius: 32rpx 32rpx 0 0; padding: 36rpx 32rpx calc(28rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.sheet-title { font-size: 36rpx; font-weight: 800; }
.sheet-sub { margin: 8rpx 0 16rpx; }
.sheet-body { max-height: 56vh; }
.cook-row { display: flex; align-items: center; padding: 20rpx 0; border-bottom: 2rpx dashed var(--line); }
.cook-emoji { font-size: 52rpx; width: 80rpx; height: 80rpx; line-height: 80rpx; text-align: center; background: var(--cell); border-radius: 16rpx; margin-right: 18rpx; flex-shrink: 0; }
.cook-info { flex: 1; min-width: 0; }
.cook-name { font-size: 30rpx; font-weight: 600; }
.over { color: #C0504A; }
.stepper { display: flex; align-items: center; flex-shrink: 0; }
.st-btn { width: 60rpx; height: 60rpx; line-height: 56rpx; text-align: center; border-radius: 30rpx; background: var(--primary-soft); color: var(--primary); font-size: 36rpx; font-weight: 700; }
.st-in { width: 110rpx; height: 60rpx; text-align: center; font-size: 30rpx; margin: 0 8rpx; background: #FBF7F0; border: 2rpx solid var(--line); border-radius: 12rpx; box-sizing: border-box; }
.st-unit { width: 60rpx; margin-left: 8rpx; font-size: 26rpx; color: var(--muted); }
.useup { display: flex; align-items: center; gap: 12rpx; flex-shrink: 0; }
.missing { padding: 20rpx 0 4rpx; }
.sheet-btns { display: flex; gap: 20rpx; margin-top: 24rpx; }
.sheet-btns .btn { flex: 1; }
