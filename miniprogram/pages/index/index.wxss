.search { margin-bottom: 20rpx; background: #fff; }
.cat-scroll { white-space: nowrap; display: flex; gap: 16rpx; margin-bottom: 24rpx; }
.cat-scroll .chip { flex-shrink: 0; }
.dish { padding: 28rpx 30rpx; }
.dish-name { font-size: 34rpx; font-weight: 700; }
.dish-emojis { font-size: 36rpx; margin: 10rpx 0 6rpx; letter-spacing: 4rpx; }
.fab {
  position: fixed; right: 40rpx; bottom: 60rpx; width: 112rpx; height: 112rpx; border-radius: 56rpx;
  background: var(--primary); color: #fff; font-size: 64rpx; line-height: 108rpx; text-align: center;
  box-shadow: 0 10rpx 30rpx rgba(217,138,61,.4); z-index: 20;
}
