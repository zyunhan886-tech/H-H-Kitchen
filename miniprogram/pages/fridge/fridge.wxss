.box { min-height: 160rpx; }
.preview { margin-top: 28rpx; border-top: 2rpx dashed var(--line); padding-top: 16rpx; }
.p-row { display: flex; align-items: center; gap: 10rpx; margin-bottom: 14rpx; }
.p-emoji { font-size: 40rpx; width: 52rpx; text-align: center; }
.p-in { background: #FBF7F0; border: 2rpx solid var(--line); border-radius: 12rpx; padding: 10rpx 14rpx; font-size: 28rpx; height: 64rpx; box-sizing: border-box; }
.p-name { flex: 1; }
.p-qty { width: 110rpx; }
.p-unit { width: 90rpx; }
.p-x { color: var(--muted); font-size: 36rpx; width: 44rpx; text-align: center; }
.row2 { display: flex; gap: 20rpx; margin-top: 20rpx; }
.row2 .btn { flex: 1; }
.section-head { display: flex; align-items: baseline; justify-content: space-between; margin: 4rpx 4rpx 20rpx; }
.h { font-size: 34rpx; font-weight: 700; }
.grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18rpx; }
.cell { box-sizing: border-box; min-width: 0; background: #fff; border: 2rpx solid var(--line); border-radius: 18rpx; overflow: hidden; text-align: center; }
.cell-emoji { background: var(--cell); font-size: 60rpx; height: 110rpx; line-height: 110rpx; }
.cell-name { font-size: 26rpx; padding: 8rpx 6rpx 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.cell-qty { font-size: 22rpx; color: var(--muted); padding-bottom: 10rpx; }

.staple-head { display: flex; justify-content: space-between; align-items: baseline; }
.link { color: var(--primary); font-size: 26rpx; margin-left: 24rpx; }
.link.muted { color: var(--muted); }
.staple-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16rpx; }
.staple { position: relative; box-sizing: border-box; min-width: 0; background: #FBF7F0; border: 2rpx solid var(--line); border-radius: 18rpx; padding: 14rpx 12rpx 12rpx; }
.staple.picked { border-color: var(--primary); background: var(--primary-soft); }
.staple-x { position: absolute; top: -12rpx; right: -12rpx; width: 40rpx; height: 40rpx; line-height: 40rpx; text-align: center; border-radius: 20rpx; background: #C0504A; color: #fff; font-size: 22rpx; z-index: 2; }
.staple-top { display: flex; align-items: center; }
.staple-emoji { font-size: 44rpx; margin-right: 8rpx; }
.staple-meta { min-width: 0; flex: 1; }
.staple-name { font-size: 28rpx; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.staple-unit { display: inline-block; font-size: 22rpx; color: var(--primary); background: #fff; border: 2rpx solid var(--line); border-radius: 20rpx; padding: 0 12rpx; line-height: 34rpx; }
.staple-stock { font-size: 20rpx; color: var(--muted); height: 30rpx; line-height: 30rpx; margin: 6rpx 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.staple-step { display: flex; align-items: center; justify-content: space-between; }
.st-btn { width: 52rpx; height: 52rpx; line-height: 48rpx; text-align: center; border-radius: 26rpx; background: #fff; border: 2rpx solid var(--line); color: var(--primary); font-size: 32rpx; font-weight: 700; flex-shrink: 0; }
.st-in { flex: 1; min-width: 0; height: 52rpx; text-align: center; font-size: 28rpx; margin: 0 6rpx; }
.add-staple { display: flex; flex-direction: column; align-items: center; justify-content: center; color: var(--primary); font-size: 44rpx; border-style: dashed; min-height: 150rpx; }
.fridge-grid { margin-bottom: 32rpx; }
